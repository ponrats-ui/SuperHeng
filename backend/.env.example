# SuperHeng backend — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# (see ../.gitignore); this template is safe to commit.
#
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows

# --- Supabase --------------------------------------------------------------
# Project URL — Supabase dashboard > Project Settings > Data API > Project URL.
# Shape: https://<project-ref>.supabase.co   (no trailing slash)
SUPABASE_URL=https://eiukzhtbslgoennqpvix.supabase.co

# Supabase API key — Project Settings > API Keys.
#
# WHICH KEY YOU NEED DEPENDS ON WHAT IS READING THIS FILE:
#
#   * scraper.py WRITES draw rows into `lottery_draws`. `schema.sql` enables
#     row-level security and defines a SELECT policy only, so there is no
#     INSERT/UPDATE policy — the `anon` key will be rejected. Ingestion needs
#     the **service_role** key, which bypasses RLS.
#
#   * main.py only needs to reach the database, so `anon` is enough there.
#
# The service_role key is a full-access admin credential for the whole project.
# It is server-side only: never put it in the Expo app, never prefix it with
# EXPO_PUBLIC_, and never commit it. Keep it out of the client bundle entirely.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpdWt6aHRic2xnb2VubnFwdml4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4Mjc4ODEsImV4cCI6MjEwNzQwMzg4MX0.abhhWIr5sz0EJ_fny3z4bswe1KYhXZqET9t8BJkuqQo
